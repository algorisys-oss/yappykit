{
  "name": "yappykit",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "Privacy-first, browser-native file and data tools. Useful tools. No uploads.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "budget": "node scripts/check-budget.mjs",
    "publish:oss": "node scripts/publish-oss.mjs",
    "zen:build": "cd vendor/zen-ui && bun install && bun run build:lib:solid",
    "postinstall": "test -f vendor/zen-ui/packages/solid/dist/index.js || echo '[yappykit] zen-ui not built — run: npm run zen:build (needs bun)'",
    "prerender": "node scripts/prerender.mjs",
    "serve": "node scripts/serve-dist.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@solidjs/router": "^0.15.3",
    "comlink": "^4.4.2",
    "exifr": "^7.1.3",
    "heic-to": "^1.5.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "solid-js": "^1.9.5",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.13.0",
    "@unocss/preset-wind": "^0.65.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "unocss": "^0.65.0",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^2.11.2",
    "vitest": "^3.0.5"
  }
}
